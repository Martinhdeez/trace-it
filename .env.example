# Setup, model downloads and API checks: docs/ingestion/setup.md.
# Credentials are optional for local-only extraction; never commit .env.
# Reproduce the full OCR committee with GEMINI_API_KEY + TYPESAFE_API_KEY.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OCR image reader: obtain your own key through Google AI Studio.
GEMINI_API_KEY=
HELMCODE_API_KEY=   # https://helmcode.com, OpenAI-compatible; models as helmcode:<id>
GOOGLE_API_KEY=   # same key as GEMINI_API_KEY; PydanticAI's `google:` models read this name
# Historical FAL OCR comparison tools only; not the production ingestion API.
FAL_KEY=
# OCR text-candidate judge: TypeSafe API access (https://typesafe.ai/).
TYPESAFE_API_KEY=

# One model per agent role, in PydanticAI's `provider:model` form (backend/app/core/config.py).
# Any PydanticAI provider works (anthropic:, openai:, google-gla:, groq:, mistral:,
# openrouter:..., helmcode:<model> with HELMCODE_API_KEY). The tester should differ from the compiler (ADR 0004). Defaults shown.
# TRACE_COMPILER_MODEL=anthropic:claude-opus-5
# TRACE_TESTER_MODEL=openai:gpt-5
# TRACE_ASSISTANT_MODEL=anthropic:claude-opus-5
# TRACE_NORMALIZER_MODEL=anthropic:claude-opus-5
# TRACE_LEARNER_MODEL=anthropic:claude-opus-5
# TRACE_DISCOVERY_MODEL=anthropic:claude-opus-5
# TRACE_COMPILE_CONCURRENCY=5
# Share of past decisions a compiled rule may change and still activate by itself.
# TRACE_AUTO_ACTIVATE_MAX_CHANGE=0.05

# OCR settings are separate from the rule-agent models above. Request options
# vlm=false / jev=false disable providers even when their keys are configured.
TRACEPAY_GEMINI_MODEL=gemini-3.1-flash-lite
TRACEPAY_JEV_MODEL=jev-1.13.0
TRACEPAY_WORKERS=2
TRACEPAY_OCR_THREADS=4
TRACEPAY_OCR_CUDA=0
# Defaults on the host are absolute paths to the repo's .models and .data.
# Compose overrides these with /srv/.models (read-only) and /srv/.data (volume).
# TRACEPAY_MODEL_DIR=/absolute/path/to/trace-it/.models
# TRACEPAY_DATA_DIR=/absolute/path/to/trace-it/.data
# Optional image-capable OpenAI-compatible service; leave unset for Gemini.
# A complete URL/model pair takes precedence over Gemini; /chat/completions is appended.
# TRACEPAY_VLM_URL=http://127.0.0.1:1234/v1
# TRACEPAY_VLM_MODEL=your-image-model
# TRACEPAY_VLM_API_KEY=

# Live monitoring (ADR 0018). Spans always go to the `events` table; these also send them
# as OpenTelemetry. Logfire cloud (free tier): a project write token. Or a local Phoenix
# (`docker compose --profile observability up -d`): http://phoenix:6006 from Docker,
# http://localhost:6006 from the host. Neither set: nothing leaves the process.
LOGFIRE_TOKEN=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://phoenix:6006

# Challenge ERP (processes/invoice-payment/sources.json names these variables).
# Demo defaults: the credentials published in the challenge's MANUAL_ERP_2009.md.
TRACE_ERP_USER=alberto
TRACE_ERP_PASSWORD=FACTURAS2009
# TRACE_ERP_URL=http://127.0.0.1:8009  (Docker sets http://host.docker.internal:8009)
