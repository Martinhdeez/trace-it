# Setup, model downloads and API checks: docs/ingestion/setup.md.
# Helmcode reads images; TypeSafe judges text candidates. Never commit .env.
# The historical Gemini committee is retired; Helmcode uses the experimental profile.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HELMCODE_API_KEY=   # https://helmcode.com, OpenAI-compatible; models as helmcode:<id>
# Historical FAL OCR comparison tools only; not the production ingestion API.
FAL_KEY=
# OCR text-candidate judge: TypeSafe API access (https://typesafe.ai/).
TYPESAFE_API_KEY=

# Where the platform keeps its data and process packs (backend/app/core/config.py).
# Docker Compose sets both; these are the host defaults.
# TRACE_DATABASE_URL=postgresql+psycopg://trace:trace@localhost:5432/trace
# TRACE_PROCESSES_DIR=/absolute/path/to/trace-it/processes
# Bearer access to every application endpoint and /db. Empty disables API tokens.
# Set only in the deployment's private runtime.env; see docs/production-api.md.
TRACE_API_TOKEN=

# One model per agent role, in PydanticAI's `provider:model` form (backend/app/core/config.py).
# Any PydanticAI provider works (anthropic:, openai:, google-gla:, groq:, mistral:,
# openrouter:..., helmcode:<model> with HELMCODE_API_KEY). A use case's own agent settings
# win over these. Defaults shown; the fallbacks apply to roles the use case does not set.
# TRACE_COMPILER_MODEL=helmcode:deepseek-v4-flash
# TRACE_TESTER_MODEL=helmcode:deepseek-v4-flash
# TRACE_ASSISTANT_MODEL=helmcode:deepseek-v4-flash
# TRACE_NORMALIZER_MODEL=helmcode:deepseek-v4-flash
# TRACE_DECISION_REVIEWER_MODEL=helmcode:deepseek-v4-flash
# TRACE_LEARNER_MODEL=helmcode:deepseek-v4-flash
# TRACE_DISCOVERY_MODEL=helmcode:deepseek-v4-flash
# TRACE_FALLBACK_MODELS=["helmcode:glm5.3","helmcode:qwen3.6"]
# Helmcode's API, for the agents and OCR alike. HELMCODE_URL is the legacy name, read
# only when TRACE_HELMCODE_BASE_URL is not set.
# TRACE_HELMCODE_BASE_URL=https://api.helmcode.com/v1
# TRACE_COMPILE_CONCURRENCY=5
# TRACE_DECISION_WORKERS=4
# Share of past decisions a compiled rule may change and still activate by itself.
# TRACE_AUTO_ACTIVATE_MAX_CHANGE=0.05

# OCR modes and billing: docs/ingestion/providers-and-modes.md.
# hybrid preserves the invoice committee; local disables provider stages;
# api uses image APIs without loading local OCR weights. Requests may override mode.
# Alternative server committees also require TRACEPAY_OCR_PROFILE=experimental.
TRACEPAY_OCR_MODE=hybrid
TRACEPAY_VISION_PROVIDERS=helmcode
# Published versions pin their reader: migrate existing Gemini versions to helmcode:qwen3.6.
TRACEPAY_TEXT_PROVIDERS=jev,helmcode
TRACEPAY_HELMCODE_VISION_MODELS=qwen3.6,gemma4
TRACEPAY_HELMCODE_TEXT_MODEL=qwen3.6
TRACEPAY_PROVIDER_TIMEOUT_S=60
# Remote vision/OCR/judge calls in flight at once, per provider (a batch of scans must not
# trip the quota). A 429/503 is retried after Retry-After, else exponential backoff with
# jitter, until this many seconds of waiting; then the next provider in the chain answers.
TRACEPAY_VISION_MAX_CONCURRENCY=3
TRACEPAY_PROVIDER_RETRY_MAX_WAIT_S=2
# GLM 5.3 is text only; never use it as an OCR image reader.
# Unknown is intentional: model access does not prove the account's billing plan.
TRACEPAY_HELMCODE_BILLING_MODE=unknown
# Use included only after verifying subscription coverage (monthly fee excluded).
# For metered billing set the account's actual USD rates per million tokens:
# TRACEPAY_HELMCODE_INPUT_USD_PER_M=
# TRACEPAY_HELMCODE_OUTPUT_USD_PER_M=

# OCR settings are separate from the rule-agent models above. Request options
# vlm=false / jev=false disable providers even when their keys are configured.
TRACEPAY_OCR_PROFILE=experimental
TRACEPAY_JEV_MODEL=jev-1.13.0
TRACEPAY_WORKERS=2
TRACEPAY_OCR_THREADS=4
TRACEPAY_OCR_CUDA=0
# 1 = re-read every PDF and resend every provider call, ignoring caches and the request journal
TRACEPAY_OCR_FORCE_RECOMPUTE=0
# 1 = also run the Postgres API tests (`make test` sets it; needs a migrated test database).
# TRACEPAY_TEST_POSTGRES=0
# Defaults on the host are absolute paths to the repo's .models and .data.
# Compose overrides these with /srv/.models (read-only) and /srv/.data (volume).
# TRACEPAY_MODEL_DIR=/absolute/path/to/trace-it/.models
# TRACEPAY_DATA_DIR=/absolute/path/to/trace-it/.data
# Optional image-capable OpenAI-compatible service; add compatible to VISION_PROVIDERS.
# A complete URL/model pair is required; /chat/completions is appended.
# TRACEPAY_VLM_URL=http://127.0.0.1:1234/v1
# TRACEPAY_VLM_MODEL=your-image-model
# TRACEPAY_VLM_API_KEY=

# Live monitoring (ADR 0018). Spans always go to the `events` table; these also send them
# as OpenTelemetry. Logfire cloud (free tier): a project write token. Or a local Phoenix
# (`docker compose --profile observability up -d`): http://phoenix:6006 from Docker,
# http://localhost:6006 from the host. Neither set: nothing leaves the process.
LOGFIRE_TOKEN=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://phoenix:6006
# `GET /health/planes` thresholds over the last window (defaults shown).
# TRACE_HEALTH_WINDOW_MINUTES=15
# TRACE_HEALTH_MIN_SPANS=5
# TRACE_HEALTH_DEGRADED_ERROR_RATE=0.05
# TRACE_HEALTH_DOWN_ERROR_RATE=0.5
# TRACE_HEALTH_P95_MS={"ingestion":10000,"agents":60000,"execution":5000}

# Challenge ERP (processes/invoice-payment/sources.json names these variables).
# Demo defaults: the credentials published in the challenge's MANUAL_ERP_2009.md.
TRACE_ERP_USER=alberto
TRACE_ERP_PASSWORD=FACTURAS2009
# TRACE_ERP_URL=http://127.0.0.1:8009  (Docker sets http://host.docker.internal:8009)

# Synthetic hiring criminal-records source.
TRACE_CRIMINAL_RECORDS_USER=people
TRACE_CRIMINAL_RECORDS_PASSWORD=SCREENING2009
# TRACE_CRIMINAL_RECORDS_URL=http://127.0.0.1:8010

# Process execution settings (see docs/process-execution.md).
# Local OpenAI-compatible endpoint; its key is optional.
TRACE_LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=
# TRACE_EXECUTION_PRESETS={"fastest":{"agents":{"assistant":{"model":"local:your-model"}}}}
