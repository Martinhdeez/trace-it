{"id": 1501, "process_id": 5, "name": "2026-01-08_P001.pdf", "status": "DECIDED", "file": {"hash": "12a5e1eff4299d5bb0816e7d87aff2ba9be39928cf0478081d14067f02d22836", "name": "2026-01-08_P001.pdf", "size_bytes": 1904, "ingested_at": "2026-09-19T01:45:59.295048Z"}, "symbols": {"base": {"value": "2489.99", "origin": "pdf-text"}, "date": {"value": "2026-01-08", "origin": "pdf-text"}, "iban": {"value": "ES21 0049 1500 0512 3456 7890", "origin": "pdf-text"}, "total": {"value": "3012.89", "origin": "pdf-text"}, "file_id": {"value": "2026-01-08_P001.pdf", "origin": "pdf-text"}, "vat_rate": {"value": "21", "origin": "pdf-text"}, "free_text": {"value": "IVA (21%): 522,90\nTOTAL: 3.012,89\nDocumento generado por el sistema de facturacion del proveedor.", "origin": "pdf-text"}, "issuer_nif": {"value": "B46102331", "origin": "pdf-text"}, "vat_amount": {"value": "522.90", "origin": "pdf-text"}, "issuer_name": {"value": "FACTURA", "origin": "pdf-text"}, "invoice_number": {"value": "Factura", "origin": "pdf-text"}, "purchase_order": {"value": "PO-2026-0096", "origin": "pdf-text"}}, "decisions": [{"id": 2096, "decision": "PAGAR", "author": "engine", "reason": null, "results": [{"hash": "9472e1ba475ae607fcc709d5a321bdb9644a2815cc4a32966b9a76df6f184837", "fires": false, "reason": "", "rule_id": 50}, {"hash": "f752fbe82d56fcf03ff0f3b80b7a689d8bba0ed9fe3755978f82c7958da0112b", "fires": false, "reason": "", "rule_id": 51}, {"hash": "50f9d5c1c36bd53a299c7592ee07f21d1506ecf35587582a0ba93e788167facd", "fires": false, "reason": "", "rule_id": 52}, {"hash": "963a82999e893f7e6b29e91108fe1d097f0f397aba02dbfbcbfefb2fc2d96032", "fires": false, "reason": "", "rule_id": 53}, {"hash": "c969839ac9a1da70f514046e9b3c04d9a164ee61a184f7f4267a88d616804f16", "fires": false, "reason": "", "rule_id": 54}, {"hash": "a1a43c74bf7575c148f0f7b54cb83cd1224e5de1e9d5634666a84ca55461449c", "fires": false, "reason": "", "rule_id": 55}, {"hash": "c0c42f82274402df7fc351b970594ec8e8e2a524980f635df82400772ff90496", "fires": false, "reason": "", "rule_id": 56}, {"hash": "d7cde2a7e493dcc615fd0e8f5dfff648230ad4d5ff53c82261bb30d7cc5e48ca", "fires": false, "reason": "", "rule_id": 57}, {"hash": "c4c68d33f45eb2443c76c7d472bfee987670836cc8e54f9849a90ab740f22b0d", "fires": false, "reason": "", "rule_id": 58}, {"hash": "d7c66984f1c6452b726b6d52e900f0ec1a37abcbc5de949a148d22513e049c55", "fires": false, "reason": "", "rule_id": 59}, {"hash": "4250d87e4e3326dd6bfe86460baf8c06e74191e669c618f011cac2ca14aa2fab", "fires": false, "reason": "", "rule_id": 60}], "rules_hash": "847e81a7fc677bb9166b4b448d4bb451eebefdc70e0ed40d26446f22d435b7a7", "created_at": "2026-09-19T02:48:38.955319Z", "rule_results": [{"rule_id": 50, "hash": "9472e1ba475ae607fcc709d5a321bdb9644a2815cc4a32966b9a76df6f184837", "fires": false, "reason": "", "rule_text": "The invoice issuer_nif (normalised: uppercase, without spaces, hyphens or dots) must match the nif of a row in suppliers.", "norm_rule_id": 19}, {"rule_id": 51, "hash": "f752fbe82d56fcf03ff0f3b80b7a689d8bba0ed9fe3755978f82c7958da0112b", "fires": false, "reason": "", "rule_text": "The invoice iban (normalised: uppercase, without spaces) must equal the iban of the supplier in suppliers whose nif matches the invoice issuer_nif.", "norm_rule_id": 19}, {"rule_id": 52, "hash": "50f9d5c1c36bd53a299c7592ee07f21d1506ecf35587582a0ba93e788167facd", "fires": false, "reason": "", "rule_text": "The invoice purchase_order (normalised: uppercase, without spaces) must exist as a purchase_order in orders.", "norm_rule_id": 20}, {"rule_id": 53, "hash": "963a82999e893f7e6b29e91108fe1d097f0f397aba02dbfbcbfefb2fc2d96032", "fires": false, "reason": "", "rule_text": "The order in orders with purchase_order equal to the invoice purchase_order must belong to the supplier: its supplier_id must equal the id of the supplier in suppliers whose nif matches the invoice issuer_nif.", "norm_rule_id": 20}, {"rule_id": 54, "hash": "c969839ac9a1da70f514046e9b3c04d9a164ee61a184f7f4267a88d616804f16", "fires": false, "reason": "", "rule_text": "The invoice total must match the total_amount of the order in orders with the same purchase_order within \u00b10.01 EUR (abs(cents(total) - cents(total_amount)) <= 1).", "norm_rule_id": 20}, {"rule_id": 55, "hash": "a1a43c74bf7575c148f0f7b54cb83cd1224e5de1e9d5634666a84ca55461449c", "fires": false, "reason": "", "rule_text": "The invoice vat_amount must equal base * vat_rate / 100 within \u00b10.01 EUR (abs(cents(vat_amount) - cents(base * vat_rate / 100)) <= 1).", "norm_rule_id": 21}, {"rule_id": 56, "hash": "c0c42f82274402df7fc351b970594ec8e8e2a524980f635df82400772ff90496", "fires": false, "reason": "", "rule_text": "The invoice total must equal base + vat_amount within \u00b10.01 EUR (abs(cents(total) - cents(base + vat_amount)) <= 1).", "norm_rule_id": 21}, {"rule_id": 57, "hash": "d7cde2a7e493dcc615fd0e8f5dfff648230ad4d5ff53c82261bb30d7cc5e48ca", "fires": false, "reason": "", "rule_text": "The invoice date must be a valid calendar date (a real YYYY-MM-DD date, not an impossible one such as 2026-02-31).", "norm_rule_id": 22}, {"rule_id": 58, "hash": "c4c68d33f45eb2443c76c7d472bfee987670836cc8e54f9849a90ab740f22b0d", "fires": false, "reason": "", "rule_text": "The invoice date must not be later than parameters.cut_off_date (date <= cut_off_date, compared as dates).", "norm_rule_id": 22}, {"rule_id": 59, "hash": "d7c66984f1c6452b726b6d52e900f0ec1a37abcbc5de949a148d22513e049c55", "fires": false, "reason": "", "rule_text": "The erp entry with purchase_order equal to the invoice purchase_order must have status 'PENDIENTE'.", "norm_rule_id": 23}, {"rule_id": 60, "hash": "4250d87e4e3326dd6bfe86460baf8c06e74191e669c618f011cac2ca14aa2fab", "fires": false, "reason": "", "rule_text": "No erp entry with purchase_order equal to the invoice purchase_order may have status 'PAGADA' (the order must not already be paid).", "norm_rule_id": 23}]}], "exported_decision": "PAGAR", "spans": [{"id": 2759, "trace_id": "01a0b790db2a9a3b6ea7aef39ddff558", "span_id": "36153dd16ee37beb", "parent_id": null, "step": "run_process", "status": "ok", "started_at": "2026-09-19T02:48:38.959320Z", "duration_ms": 634, "data": {"rules": 11, "failures": {"MISSING_DATA": 29}, "instances": 500, "by_decision": {"PAGAR": 435, "ESCALAR": 29, "NO_PAGAR": 36}}, "instance_id": null, "process_id": 5, "rule_id": null, "norm_rule_id": null, "children": [{"id": 2748, "trace_id": "01a0b790db2a9a3b6ea7aef39ddff558", "span_id": "c2de4fc96fc8b8f2", "parent_id": "36153dd16ee37beb", "step": "evaluate_rule", "status": "ok", "started_at": "2026-09-19T02:48:38.993389Z", "duration_ms": 41, "data": {"fired": 3, "errors": 0, "instances": 500}, "instance_id": null, "process_id": 5, "rule_id": 50, "norm_rule_id": null, "children": []}, {"id": 2749, "trace_id": "01a0b790db2a9a3b6ea7aef39ddff558", "span_id": "3060f4b0aebab0bd", "parent_id": "36153dd16ee37beb", "step": "evaluate_rule", "status": "ok", "started_at": "2026-09-19T02:48:39.036334Z", "duration_ms": 35, "data": {"fired": 8, "errors": 0, "instances": 500}, "instance_id": null, "process_id": 5, "rule_id": 51, "norm_rule_id": null, "children": []}, {"id": 2750, "trace_id": "01a0b790db2a9a3b6ea7aef39ddff558", "span_id": "2b583e2f8a6a32d3", "parent_id": "36153dd16ee37beb", "step": "evaluate_rule", "status": "ok", "started_at": "2026-09-19T02:48:39.072539Z", "duration_ms": 45, "data": {"fired": 3, "errors": 0, "instances": 500}, "instance_id": null, "process_id": 5, "rule_id": 52, "norm_rule_id": null, "children": []}, {"id": 2751, "trace_id": "01a0b790db2a9a3b6ea7aef39ddff558", "span_id": "9aebcf9d75e8ca60", "parent_id": "36153dd16ee37beb", "step": "evaluate_rule", "status": "ok", "started_at": "2026-09-19T02:48:39.118566Z", "duration_ms": 63, "data": {"fired": 2, "errors": 0, "instances": 500}, "instance_id": null, "process_id": 5, "rule_id": 53, "norm_rule_id": null, "children": []}, {"id": 2752, "trace_id": "01a0b790db2a9a3b6ea7aef39ddff558", "span_id": "1206678729fe5331", "parent_id": "36153dd16